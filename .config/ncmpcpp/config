# ncmpcpp config — TUI frontend for MPD
# Edit: $EDITOR ~/.config/ncmpcpp/config
# Keybindings: ? inside ncmpcpp

mpd_host = 127.0.0.1
mpd_port = 6600
mpd_music_dir = ~/Music

# Appearance
user_interface                = classic
media_library_primary_tag     = album_artist
playlist_display_mode         = columns
browser_display_mode          = columns
search_engine_display_mode    = columns

# Progress bar
progressbar_look              = ━━╸

# Columns layout: artist | title | album | duration
song_columns_list_format      = (20)[cyan]{a} (40)[white]{t} (30)[magenta]{b} (7)[green]{l}

# Visualizer (pairs with cava, or use ncmpcpp's built-in)
visualizer_data_source        = /tmp/mpd.fifo
visualizer_output_name        = mpd_visualizer
visualizer_type               = spectrum
visualizer_look               = ●▮

# Colors (Catppuccin-inspired)
color1                        = cyan
color2                        = magenta
header_window_color           = cyan
volume_color                  = green
state_line_color              = white
state_flags_color             = cyan
main_window_color             = white
main_window_highlight_color   = cyan
statusbar_color               = white
alternative_ui_separator_color = cyan
