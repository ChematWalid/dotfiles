# i3 config file (v4) - Catppuccin Mocha Rice
# ══════════════════════════════════════════════════════════════════════════════
# Master configuration file modularized into ~/.config/i3/conf.d/
# Individual components can be inspected and edited cleanly in:
#   • 00-variables.conf   — Mod keys, fonts, drag modifiers, borders
#   • 10-autostart.conf   — System daemons, background tools, autotiling
#   • 20-theme.conf       — Catppuccin Mocha window borders & palette
#   • 30-media.conf       — Audio volume OSD, brightness OSD, playerctl
#   • 40-navigation.conf  — Window focus, move, split, layouts, fullscreen
#   • 50-workspaces.conf  — Workspaces 1-10 definitions & container routing
#   • 60-apps.conf        — App launchers, rofi, flameshot, shazam, scratchpad
#   • 70-rules.conf       — Window floating criteria & size assignments
# ══════════════════════════════════════════════════════════════════════════════

include ~/.config/i3/conf.d/*.conf
