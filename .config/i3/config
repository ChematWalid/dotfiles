# i3 config file (v4) - Catppuccin Mocha Rice
# Mod1 = Alt (Primary $mod), Mod4 = Super / Windows Key

set $mod Mod1
set $super Mod4

# Font for window titles
font pango:JetBrainsMono Nerd Font 10

# Autostart applications
exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id xss-lock --transfer-sleep-lock -- ~/.local/bin/lock.sh
exec --no-startup-id nm-applet
exec --no-startup-id blueman-applet
exec --no-startup-id picom -b
exec --no-startup-id dunst
exec --no-startup-id flameshot
exec_always --no-startup-id ~/.config/polybar/launch.sh
exec_always --no-startup-id systemctl --user restart i3-autoname.service

# Wallpaper — rotate through ~/Pictures/walls-catppuccin-mocha/ every 30 min
exec_always --no-startup-id ~/.local/bin/wallpaper-rotate.sh &

# Audio volume controls (Media Keys + Alt/Win+F1..F3 for non-Fn keyboards)
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.local/bin/volume-osd.sh up
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.local/bin/volume-osd.sh down
bindsym XF86AudioMute exec --no-startup-id ~/.local/bin/volume-osd.sh mute
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

bindsym Mod4+F1 exec --no-startup-id ~/.local/bin/volume-osd.sh mute
bindsym Mod4+F2 exec --no-startup-id ~/.local/bin/volume-osd.sh down
bindsym Mod4+F3 exec --no-startup-id ~/.local/bin/volume-osd.sh up
bindsym $mod+F1 exec --no-startup-id ~/.local/bin/volume-osd.sh mute
bindsym $mod+F2 exec --no-startup-id ~/.local/bin/volume-osd.sh down
bindsym $mod+F3 exec --no-startup-id ~/.local/bin/volume-osd.sh up

# Media player controls
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause 2>/dev/null
bindsym XF86AudioNext exec --no-startup-id playerctl next 2>/dev/null
bindsym XF86AudioPrev exec --no-startup-id playerctl previous 2>/dev/null
bindsym Mod4+F7 exec --no-startup-id playerctl previous 2>/dev/null
bindsym Mod4+F8 exec --no-startup-id playerctl play-pause 2>/dev/null
bindsym Mod4+F9 exec --no-startup-id playerctl next 2>/dev/null
bindsym $mod+F7 exec --no-startup-id playerctl previous 2>/dev/null
bindsym $mod+F8 exec --no-startup-id playerctl play-pause 2>/dev/null
bindsym $mod+F9 exec --no-startup-id playerctl next 2>/dev/null

# Drag floating windows
floating_modifier $mod
tiling_drag modifier titlebar

# --- Core Keybindings ---
# Terminal
bindsym $mod+Return exec kitty
bindsym $super+Return exec alacritty

# Kill focused window
bindsym $mod+Shift+q kill
bindsym $mod+Shift+a kill
bindsym $mod+q kill
bindsym Mod1+F4 kill

# Application Launcher (Rofi)
bindsym $mod+d exec --no-startup-id rofi -show drun -theme ~/.config/rofi/config.rasi
bindsym $mod+space exec --no-startup-id rofi -show drun -theme ~/.config/rofi/config.rasi
bindsym $mod+Tab exec --no-startup-id rofi -show window -theme ~/.config/rofi/config.rasi

# ── Screenshot Utilities (Flameshot) ──────────────────────────
bindsym Print exec --no-startup-id flameshot gui
bindsym Mod4+Shift+s exec --no-startup-id flameshot gui
bindsym $mod+Shift+s exec --no-startup-id flameshot gui
bindsym Shift+Print exec --no-startup-id flameshot full -c
bindsym Control+Print exec --no-startup-id flameshot gui -d 3000
bindsym Mod4+Print exec --no-startup-id flameshot screen -c


# Quick App Launchers
bindsym $mod+b exec google-chrome-stable
bindsym $mod+Shift+b exec firefox
bindsym $mod+e exec thunar
bindsym $mod+t exec telegram-desktop
bindsym $mod+c exec code

# Change focus (Vim keys & Arrow keys)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Split orientation
bindsym $mod+backslash split h
bindsym $mod+minus split v

# Polybar toggle on demand (Alt+F)
bindsym $mod+f exec --no-startup-id ~/.local/bin/toggle-polybar.sh

# Window Fullscreen toggle (Super+F & Alt+Shift+F)
bindsym Mod4+f fullscreen toggle
bindsym $mod+Shift+f fullscreen toggle

# Toggle floating / tiling
bindsym $mod+Shift+space floating toggle

# Layout styles
bindsym $mod+z layout tabbed
bindsym $mod+x layout toggle split

# Workspace names / definitions
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Reload / Restart i3
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# Exit / Power
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3?' -B 'Yes, exit' 'i3-msg exit'"
bindsym $mod+Shift+x exec bash ~/.local/bin/lock.sh

# Window layout defaults
default_border pixel 0
default_floating_border pixel 0

# Window Rules (Floating)
for_window [class="Pavucontrol"] floating enable
for_window [class="Lxappearance"] floating enable

for_window [class="File-roller"] floating enable

# --- Window Color Theme (borders transparent — pixel 0) ---
# class                 border    bground   text      indicator  child_border
client.focused          #00000000 #1e1e2e   #cdd6f4   #00000000  #00000000
client.focused_inactive #00000000 #181825   #a6adc8   #00000000  #00000000
client.unfocused        #00000000 #181825   #6c7086   #00000000  #00000000
client.urgent           #00000000 #f38ba8   #11111b   #00000000  #00000000
client.placeholder      #00000000 #181825   #cdd6f4   #00000000  #00000000
client.background       #1e1e2e
exec --no-startup-id /usr/bin/gnome-keyring-daemon --start --components=pkcs11,secrets,ssh
exec_always --no-startup-id sh -c 'killall -q conky; sleep 0.2; conky -c ~/.config/conky/conky.conf -q &'
exec_always --no-startup-id sh -c 'pkill -f desktop-music-daemon.py; sleep 0.2; ~/.local/bin/desktop-music-daemon.py &'

# ── Input Settings (Keyboard Layouts, 250 50 Repeat Rate, Mouse Raw Input) ──
exec_always --no-startup-id ~/.local/bin/apply-input-settings.sh

# ── Brightness controls (Hardware Keys & Alt/Win+F5..F6) ─────────────────────
bindsym XF86MonBrightnessUp exec --no-startup-id ~/.local/bin/brightness-osd.sh up
bindsym XF86MonBrightnessDown exec --no-startup-id ~/.local/bin/brightness-osd.sh down
bindsym Mod4+F5 exec --no-startup-id ~/.local/bin/brightness-osd.sh down
bindsym Mod4+F6 exec --no-startup-id ~/.local/bin/brightness-osd.sh up
bindsym $mod+F5 exec --no-startup-id ~/.local/bin/brightness-osd.sh down
bindsym $mod+F6 exec --no-startup-id ~/.local/bin/brightness-osd.sh up
exec --no-startup-id xsettingsd -c ~/.config/xsettingsd/xsettingsd.conf
focus_on_window_activation focus

# ── Lock Screen (Win+L & Alt+Ctrl+L) ───────────────
bindsym Mod4+l exec --no-startup-id ~/.local/bin/lock.sh
bindsym $mod+Control+l exec --no-startup-id ~/.local/bin/lock.sh

# ── Bitwarden / Vaultwarden Password Auto-Typer (Win+P & Alt+P) ──
bindsym Mod4+p exec --no-startup-id rofi-rbw
bindsym $mod+p exec --no-startup-id rofi-rbw

# ── CopyQ Clipboard Manager (Follows active workspace & works in all layouts) ──
for_window [class="[cC]opy[qQ]"] floating enable, resize set 650 500, move position center
bindcode Mod1+55 exec --no-startup-id ~/.local/bin/toggle-copyq.sh
bindcode Mod4+55 exec --no-startup-id ~/.local/bin/toggle-copyq.sh


# ── Super+Shift+Number secondary move container bindings ──
bindsym Mod4+Shift+1 move container to workspace number $ws1
bindsym Mod4+Shift+2 move container to workspace number $ws2
bindsym Mod4+Shift+3 move container to workspace number $ws3
bindsym Mod4+Shift+4 move container to workspace number $ws4
bindsym Mod4+Shift+5 move container to workspace number $ws5
bindsym Mod4+Shift+6 move container to workspace number $ws6
bindsym Mod4+Shift+7 move container to workspace number $ws7
bindsym Mod4+Shift+8 move container to workspace number $ws8
bindsym Mod4+Shift+9 move container to workspace number $ws9
bindsym Mod4+Shift+0 move container to workspace number $ws10

# ── Scratchpad Dropdown Terminal (Alt+U & Win+U) ───
for_window [instance="scratchpad_term"] floating enable, resize set 900 550, move position center, move to scratchpad
bindsym $mod+u exec --no-startup-id ~/.local/bin/toggle-scratchpad.sh
bindsym Mod4+u exec --no-startup-id ~/.local/bin/toggle-scratchpad.sh

# ── Rofi Calculator (Alt+= & Win+C) ───────────────
bindsym $mod+equal exec --no-startup-id "rofi -show calc -modi calc -no-show-match -no-sort -theme ~/.config/rofi/config.rasi"
bindsym Mod4+c exec --no-startup-id "rofi -show calc -modi calc -no-show-match -no-sort -theme ~/.config/rofi/config.rasi"

# ── Rofi Web Search (Alt+Shift+W & Win+W) ─────────
bindsym $mod+Shift+w exec --no-startup-id ~/.local/bin/rofi-websearch.sh
bindsym Mod4+w exec --no-startup-id ~/.local/bin/rofi-websearch.sh

# ── Disable X11 Screen Blanking & Sleep ───────────
exec_always --no-startup-id xset s off -dpms s noblank

# ── Smart Autotiling (Auto switches vertical/horizontal splits based on aspect ratio) ──
exec_always --no-startup-id pkill -x autotiling; autotiling -sr 1.0
bindsym $mod+Shift+t exec --no-startup-id ~/.local/bin/toggle-autotiling.sh
bindsym Mod4+Shift+t exec --no-startup-id ~/.local/bin/toggle-autotiling.sh
bindsym $mod+Shift+Control+x [con_on_workspace=current] kill

# ── Language / Keyboard Layout Switcher (Win+Space) ─────────────
bindsym Mod4+space exec --no-startup-id ~/.local/bin/switch-layout.sh

# ── Wallpaper — pick next now (Super+N) ─────────────────────────
bindsym Mod4+n exec --no-startup-id ~/.local/bin/wallpaper-next.sh
