# Stalonetray tray popup, styled to match the existing Polybar tray.
# Icons are displayed in a clean single row positioned above Polybar.
background "#313244"
decorations border
dockapp_mode none
geometry 10x1-24-44
grow_gravity NW
icon_gravity NE
icon_size 16
slot_size 22
max_geometry 0x1
no_shrink false
skip_taskbar true
sticky true
window_layer top
window_strut none
window_type utility
vertical false
xsync false
kludges force_icons_size
