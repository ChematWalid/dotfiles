[Unit]
Description=Polybar status bar and multi-row system tray
After=i3-session.target picom.service
PartOf=i3-session.target
ConditionEnvironment=DISPLAY
ConditionEnvironment=XAUTHORITY
StartLimitIntervalSec=30s
StartLimitBurst=5

[Service]
Type=oneshot
ExecStart=%h/.config/polybar/launch.sh
ExecStop=%h/.config/polybar/launch.sh --stop
RemainAfterExit=yes
Restart=on-failure
RestartSec=3s
TimeoutStopSec=3s
