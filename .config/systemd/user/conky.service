[Unit]
Description=Conky Desktop Clock and Song Display
Requires=picom.service
After=picom.service i3-session.target
PartOf=i3-session.target
ConditionEnvironment=DISPLAY
ConditionEnvironment=XAUTHORITY
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.local/opt/conky-1.25.3/bin/conky -c %h/.config/conky/conky.conf -q
Restart=always
RestartSec=1
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus

[Install]
# Started from i3 after the X display and compositor are ready.
