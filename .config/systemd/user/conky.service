[Unit]
Description=Conky Desktop Clock and Song Display
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=/usr/bin/bash -c 'for i in {1..30}; do pgrep -x picom >/dev/null && break; sleep 0.1; done'
ExecStart=/usr/bin/conky -c /home/walid/.config/conky/conky.conf -q
Restart=always
RestartSec=1
Environment=DISPLAY=:0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus

[Install]
WantedBy=default.target
