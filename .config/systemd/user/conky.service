[Unit]
Description=Conky Desktop Clock and Song Display
Wants=picom.service
After=picom.service i3-session.target
PartOf=i3-session.target
ConditionEnvironment=DISPLAY
ConditionEnvironment=XAUTHORITY
StartLimitIntervalSec=30s
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/conky -c %h/.config/conky/conky.conf -q
Restart=always
RestartSec=2
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
Environment=XDG_CURRENT_DESKTOP=i3

[Install]
# Started from i3 after the X display and compositor are ready.
