[Unit]
Description=Reapply X11 input settings when input devices change
After=graphical-session.target
ConditionEnvironment=DISPLAY
ConditionEnvironment=XAUTHORITY

[Service]
Type=simple
ExecStart=%h/.local/bin/input-watch-daemon.sh
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
