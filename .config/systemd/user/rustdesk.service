[Unit]
Description=RustDesk Remote Desktop (user session)
After=i3-session.target
PartOf=i3-session.target

[Service]
Type=simple
ExecStart=/usr/bin/rustdesk --server
Restart=always
RestartSec=5s
Environment="PULSE_LATENCY_MSEC=60"
Environment="PIPEWIRE_LATENCY=1024/48000"

[Install]
WantedBy=i3-session.target
