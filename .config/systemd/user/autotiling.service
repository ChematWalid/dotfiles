[Unit]
Description=Native event-driven i3 autotiling
After=i3-session.target
PartOf=i3-session.target
ConditionEnvironment=DISPLAY
ConditionEnvironment=XAUTHORITY
StartLimitIntervalSec=30s
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/autoname-workspaces --autotiling
Restart=on-failure
RestartSec=2
