[Unit]
Description=Desktop Music Now-Playing Daemon (playerctl → /tmp/conky-music.txt)
After=graphical-session.target

[Service]
Type=simple
ExecStart=/home/walid/.local/bin/desktop-music-daemon
Restart=always
RestartSec=2
Environment=DISPLAY=:0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus

[Install]
WantedBy=default.target
