[Unit]
Description=Wallpaper Rotation Daemon (30-min cycle)
After=i3-session.target
PartOf=i3-session.target
ConditionEnvironment=DISPLAY
ConditionEnvironment=XAUTHORITY
StartLimitIntervalSec=30s
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/wallpaper-rotate.sh
Restart=always
RestartSec=3
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus

[Install]
# Started from i3 after the X display is ready.
