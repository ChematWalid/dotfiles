{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "magenta",
      "2": "blue"
    }
  },
  "display": {
    "color": {
      "keys": "magenta",
      "title": "blue"
    },
    "separator": " 󰄾 "
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "OS", "keyColor": "blue" },
    { "type": "kernel", "key": "Kernel", "keyColor": "blue" },
    { "type": "uptime", "key": "Uptime", "keyColor": "blue" },
    { "type": "packages", "key": "Packages", "keyColor": "blue" },
    { "type": "shell", "key": "Shell", "keyColor": "magenta" },
    { "type": "wm", "key": "WM", "keyColor": "magenta" },
    { "type": "terminal", "key": "Terminal", "keyColor": "magenta" },
    { "type": "cpu", "key": "CPU", "keyColor": "green" },
    { "type": "gpu", "key": "GPU", "keyColor": "green" },
    { "type": "memory", "key": "Memory", "keyColor": "green" },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
