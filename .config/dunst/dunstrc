# ==============================================================================
#                      DUNST NOTIFICATION DAEMON CONFIG
#                       Catppuccin Mocha - Mauve Edition
# ==============================================================================

[global]
    # --- Display & Positioning ---
    monitor = 0
    follow = mouse
    width = (300, 420)
    height = (0, 320)
    origin = top-right
    offset = (16, 52)
    scale = 0
    notification_limit = 6

    # --- Progress Bar (OSD: Volume / Brightness) ---
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 4
    highlight = "#cba6f7"

    # --- Windows, Borders & Radii ---
    indicate_hidden = yes
    transparency = 5
    separator_height = 0
    padding = 12
    horizontal_padding = 16
    text_icon_padding = 14
    frame_width = 0
    frame_color = "#cba6f7"
    gap_size = 8
    separator_color = frame
    sort = yes
    idle_threshold = 120
    corner_radius = 10

    # --- Typography & Formatting ---
    font = JetBrainsMono Nerd Font 10
    line_height = 3
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    # --- Icons & Artwork ---
    enable_recursive_icon_lookup = true
    icon_theme = "Papirus-Dark"
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64
    icon_path = /usr/share/icons/Papirus-Dark/16x16/status/:/usr/share/icons/Papirus-Dark/16x16/devices/:/usr/share/icons/Papirus-Dark/16x16/apps/:/usr/share/icons/Papirus-Dark/24x24/status/:/usr/share/icons/Papirus-Dark/24x24/devices/:/usr/share/icons/Papirus-Dark/24x24/apps/:/usr/share/icons/Papirus-Dark/48x48/status/:/usr/share/icons/Papirus-Dark/48x48/devices/:/usr/share/icons/Papirus-Dark/48x48/apps/:/usr/share/icons/hicolor/48x48/apps/:/usr/share/icons/hicolor/scalable/apps/

    # --- History & Interactivity ---
    sticky_history = yes
    history_length = 30
    dmenu = /usr/bin/rofi -dmenu -p "Notifications"
    browser = /usr/bin/firefox -new-tab
    always_run_script = false
    title = Dunst
    class = Dunst
    ignore_dbusclose = false

    # --- Mouse Actions ---
    # Left click: trigger default action & switch focus to window
    mouse_left_click = do_action, close_current
    # Middle click: dismiss all notifications
    mouse_middle_click = close_all
    # Right click: dismiss current notification
    mouse_right_click = close_current

# ==============================================================================
#                              URGENCY LEVELS
# ==============================================================================

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"
    highlight = "#89b4fa"
    timeout = 4
    default_icon = "dialog-information"

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#cba6f7"
    highlight = "#cba6f7"
    timeout = 6
    default_icon = "dialog-information"

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    highlight = "#f38ba8"
    timeout = 0
    default_icon = "dialog-warning"

# ==============================================================================
#                          PER-APPLICATION RULES
# ==============================================================================

