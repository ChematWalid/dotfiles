[global]
    frame_width = 0
    separator_height = 0
    corner_radius = 8
    width = (0, 320)
    height = (0, 300)
    offset = (10, 50)
    origin = top-right
    transparency = 10
    font = JetBrainsMono Nerd Font 10

    # Click left on notification → focus that app's window
    mouse_left_click = do_action, close_current
    mouse_right_click = close_current
    mouse_middle_click = close_all

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    script = ~/.config/dunst/focus-app.sh

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    script = ~/.config/dunst/focus-app.sh

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    script = ~/.config/dunst/focus-app.sh

[volume]
    appname = "Volume"
    script = ""

[brightness]
    appname = "brightness"
    script = ""
