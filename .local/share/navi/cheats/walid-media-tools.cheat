% instagram, social, cli, instagram-cli

# Login / authenticate to Instagram
instagram-cli auth

# View your feed (all followed accounts)
instagram-cli feed

# View a specific user's feed
instagram-cli feed <username>

# Open direct messages with a user
instagram-cli chat <username>

# Open inbox (list all DM conversations)
instagram-cli chat

# View available stories
instagram-cli stories

# Set up push notifications for user
instagram-cli notify <username>

# Configure a setting
instagram-cli config <key> <value>

# Show current config value
instagram-cli config <key>

# Cleanup session/cache
instagram-cli cleanup

% gallery-dl, download, images, media, gdl

# Download all media from URL (Instagram, Reddit, Twitter, Pixiv, DeviantArt…)
gallery-dl <url>

# Download to a specific folder
gallery-dl -d ~/Pictures/<folder> <url>

# Download with original filenames
gallery-dl -f /O <url>

# List URLs without downloading (dry-run)
gallery-dl -g <url>

# Download from file of URLs
gallery-dl -i <urls.txt>

# Use cookies from browser for auth
gallery-dl --cookies-from-browser firefox <url>

# Limit pages to download
gallery-dl --range 1-5 <url>

# Set structured output filename pattern
gallery-dl -f "{category}/{user}/{filename}.{extension}" <url>

# Download Instagram user's gallery
gallery-dl --cookies-from-browser firefox https://www.instagram.com/<username>/

% spotdl, spotify, music, download, spot

# Download a Spotify track by URL
spotdl download <spotify_track_url>

# Download an album
spotdl download <spotify_album_url>

# Download an entire playlist
spotdl download <spotify_playlist_url>

# Search and download by artist + title
spotdl download "<artist> - <song>"

# Download as FLAC
spotdl download <url> --format flac

# Download with 320k bitrate MP3
spotdl download <url> --format mp3 --bitrate 320k

# Set output folder and naming pattern
spotdl download <url> --output ~/Music/{artist}/{album}/{title}

# Sync a playlist (add new, remove deleted)
spotdl sync <spotify_playlist_url> --save-file playlist.spotdl

# Re-sync from saved .spotdl file
spotdl sync playlist.spotdl

# Save playlist reference file (no download)
spotdl save <playlist_url> --save-file playlist.spotdl

# Generate LRC lyrics alongside download
spotdl download <url> --generate-lrc

% yt-dlp, youtube, video, audio, download

# Download video best quality
yt-dlp <url>

# Download best video + audio merged as MP4
yt-dlp -f "bestvideo+bestaudio" --merge-output-format mp4 <url>

# Download audio only as best quality MP3
yt-dlp -x --audio-format mp3 --audio-quality 0 <url>

# Download in specific resolution (1080p)
yt-dlp -f "bestvideo[height<=1080]+bestaudio" --merge-output-format mp4 <url>

# List all available formats
yt-dlp -F <url>

# Download with custom output filename pattern
yt-dlp -o "%(uploader)s/%(title)s.%(ext)s" <url>

# Download entire playlist (numbered)
yt-dlp -o "%(playlist_index)s-%(title)s.%(ext)s" <playlist_url>

# Download only first N items
yt-dlp --playlist-items 1-<N> <playlist_url>

# Download with English subtitles
yt-dlp --write-sub --sub-lang en <url>

# Use browser cookies for auth (age-gated, members-only)
yt-dlp --cookies-from-browser firefox <url>

# Skip already downloaded files (archive)
yt-dlp --download-archive downloaded.txt <url>

# Rate limit download to 2MB/s
yt-dlp -r 2M <url>

# Dump metadata as JSON without downloading
yt-dlp --dump-json <url>

% aider, ai, coding, llm

# Start aider in current repo
aider

# Start with specific files
aider <file1> <file2>

# Use Claude Sonnet
aider --model claude-sonnet-4-5

# Use Gemini Flash
aider --model gemini/gemini-2.0-flash

# Architect mode (two-step: plan + implement)
aider --architect

# Show diffs after every change
aider --show-diffs

# One-shot non-interactive message
aider --message "<instruction>"

# Restore previous chat history
aider --restore-chat-history

# No auto-commit mode
aider --no-auto-commits

% pdftocgen, pdftocio, pdfxmeta, pdf, toc

# Extract metadata from PDF to identify heading patterns
pdfxmeta <file.pdf>

# Extract metadata from a specific page
pdfxmeta -p <page_num> <file.pdf>

# Generate a TOC from a PDF (prints to stdout)
pdftocgen <file.pdf>

# Generate TOC and save to file
pdftocgen <file.pdf> > toc.txt

# Import TOC into PDF (creates new PDF)
pdftocio <file.pdf> < toc.txt

# Import TOC and set output path
pdftocio -o <output.pdf> <file.pdf> < toc.txt

% instaloader, instagram, download

# Download all posts from a public profile
instaloader <username>

# Download stories and highlights too
instaloader --stories --highlights <username>

# Download your own saved posts
instaloader :saved

# Download your own profile
instaloader :self

# Resume interrupted download
instaloader --latest-stamps <username>

% wallpaper, desktop, feh, background

# View current wallpaper directory and image count
wallpaper-dir

# Change wallpaper directory (searches 3 folders deep)
wallpaper-dir <folder_path>

# Reset wallpaper directory to default Catppuccin collection
wallpaper-dir reset

# Pick next random wallpaper immediately (Super + N)
wallpaper-next.sh

% spotifyd, spotify, daemon, music, rust

# Start spotifyd daemon manually with config
spotifyd --no-daemon --config-path ~/.config/spotifyd/spotifyd.conf

# Start spotifyd systemd user service
systemctl --user start spotifyd

# Stop spotifyd systemd user service
systemctl --user stop spotifyd

# Enable spotifyd at user login
systemctl --user enable spotifyd

# Check spotifyd status and logs
systemctl --user status spotifyd

# View spotifyd live journal logs
journalctl --user -u spotifyd -f

% mopidy, iris, music, web, mpd, mpris

# Start mopidy with Iris web client
mopidy

# Start mopidy systemd user service
systemctl --user start mopidy

# Stop mopidy systemd user service
systemctl --user stop mopidy

# Enable mopidy at user login
systemctl --user enable mopidy

# Check mopidy status and logs
systemctl --user status mopidy

# Open Iris web interface in browser (port 6680)
xdg-open http://localhost:6680/iris/

# Connect ncmpcpp to Mopidy MPD server (port 6601)
ncmpcpp -p 6601
