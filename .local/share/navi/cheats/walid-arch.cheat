% system, arch, pacman, packages

# Update all packages (pacman + AUR via yay)
update

# Full system upgrade with AUR
yay -Syu

# Install a package (AUR-aware)
yay -S <package>

# Remove package and unused dependencies
sudo pacman -Rns <package>

# Search for a package
yay -Ss <package>

# List explicitly installed packages
pacman -Qqe

# Clean pacman cache, orphans, and journal
cleanup

# Clean only pacman cache (keep last 2 versions)
sudo paccache -r

# Downgrade a package to a previous version
downgrade <package>

# Show package info
pacman -Qi <package>

# Show files owned by a package
pacman -Ql <package>

# Find which package owns a file
pacman -Qo <file>

# List orphaned packages
pacman -Qtdq

# Check for failed systemd services
systemctl --failed

# Enable and start a service
sudo systemctl enable --now <service>

# Restart a service
sudo systemctl restart <service>

# Show service logs (live)
journalctl -fu <service>

# Vacuum journal logs older than 3 days
sudo journalctl --vacuum-time=3d

# UFW firewall status
sudo ufw status verbose

# Allow a port through firewall
sudo ufw allow <port>

# Show CPU power info
cpupower frequency-info

# Set CPU governor
sudo cpupower frequency-set -g <governor>

% system, monitoring, resources

# All-in-one system overview (glances)
sys

# Interactive process monitor (btop)
btop

# GPU usage monitor (nvtop)
nvtop

# Disk usage visual, biggest at bottom (dust)
dust

# Disk usage interactive ncurses (gdu)
du

# Disk space overview, modern df (duf)
df

# Network bandwidth monitor per process
bandwhich

# Show smart disk health
sudo smartctl -a /dev/<disk>

# Show running processes (procs)
ps

% files, navigation, search

# Open Yazi async file manager
y

# Open LF terminal file manager
lf

# Open Superfile file manager
spf

# Interactive broot tree navigator
b

# Long list with icons, git status, hidden files
ll

# List files with icons, grouped dirs first
ls

# Tree view 2 levels deep
lt

# Tree view custom depth
eza --tree --icons --level=<depth>

# Fast file search by name (fd)
fd <pattern>

# Find files by name across all drives (plocate)
plocate <filename>

# Recursive text search (ripgrep)
rg '<pattern>'

# Ripgrep in specific file type
rg '<pattern>' -t <filetype>

# AST code-structure-aware search
sg '<pattern>' --lang <language>

# Interactive fuzzy file finder (fzf)
fzf

# SQL-like file queries (fselect)
fselect name from <dir> where size > 1mb

# Safely move file to trash
tp <file>

# List all items in trash
tl

# Interactively restore from trash
trs

# Empty trash permanently
te

# Decompress any archive
unpack <archive>

# Compress files into archive
pack <files...> <output.tar.gz>

# Copy file with progress bar
rsync -ah --progress <src> <dest>

# Sync two directories
rsync -avz --delete <src>/ <dest>/

% files, disk, backup, rclone

# List rclone remotes
rclone listremotes

# Copy local to remote
rclone copy <local_path> <remote>:<path>

# Sync local to remote (one-way)
rclone sync <local> <remote>:<path>

# Mount remote as filesystem
rclone mount <remote>:<path> <mountpoint> --daemon

# Show rclone remote stats
rclone about <remote>:

# Timeshift — create manual snapshot
sudo timeshift --create --comments "<label>"

# Timeshift — list snapshots
sudo timeshift --list

# Timeshift — restore snapshot
sudo timeshift --restore

% text, editor, markdown

# Open file in Neovim
v <file>

# Open file in Nano
nano <file>

# Render Markdown beautifully in terminal
md <file.md>

# View file with syntax highlighting (bat)
cat <file>

# View file with line numbers (bat)
bat -n <file>

# Replace text in file (modern sed)
sd '<old>' '<new>' <file>

# Replace across multiple files
sd '<old>' '<new>' $(fd -e <ext>)

# Select columns like cut/awk
choose <col_indices>

# Convert document to PDF (pandoc)
pandoc <input.md> -o <output.pdf>

# Convert Markdown to HTML
pandoc <input.md> -o <output.html>

% data, spreadsheets, json, csv

# Open CSV/JSON/XLSX in VisiData
vd <file>

# Query JSON/YAML/TOML values (dasel)
dasel -f <file> '<selector>'

# Pretty-print JSON (jq)
jq '.' <file.json>

# Flatten nested JSON to dotted paths (gron)
gron <file.json>

# Filter CSV rows (miller)
mlr --csv filter '$col == "<value>"' <file.csv>

# Stats on CSV column
mlr --csv stats1 -a mean,min,max -f <column> <file.csv>

# Convert CSV to JSON
mlr --csv --ojson cat <file.csv>

# CSV stats overview (xsv)
xsv stats <file.csv>

# Select CSV columns
xsv select <col1,col2> <file.csv>

% git, version control

# Open Lazygit TUI
lg

# Open GitUI TUI
gg

# Open GitHub TUI dashboard
ghd

# Clone repository
git clone <url>

# Stage all changes
git add -A

# Commit with message
git commit -m "<message>"

# Push current branch
git push

# Pull with rebase
git pull --rebase

# Pull, rebase, push (one command)
git sync

# Undo last commit, keep changes
git undo

# Add staged to last commit
git amend

# Visual branch graph
git graph

# View semantic diffs (difftastic)
dlog

# Stash changes
git stash

# Pop stash
git stash pop

# Create and switch to new branch
git checkout -b <branch>

# Delete local branch
git branch -d <branch>

# Interactive rebase last N commits
git rebase -i HEAD~<n>

# Cherry-pick a commit
git cherry-pick <hash>

# Show diff of staged changes
git diff --staged

# Search commits by message
git log --grep '<term>'

% github, gh cli

# Create a pull request
gh pr create

# List open PRs
gh pr list

# View PR status and checks
gh pr status

# Merge PR
gh pr merge <number>

# Create an issue
gh issue create

# List issues
gh issue list

# View CI/CD runs
gh run list

# Watch a workflow run live
gh run watch

# Clone a repo
gh repo clone <owner>/<repo>

# Fork a repo
gh repo fork <owner>/<repo>

% docker, containers

# Open Lazydocker TUI
ld

# Open Portainer Web GUI (localhost:9000)
dgui

# Live container metrics (ctop)
dtop

# Show running containers formatted
dps

# Show all containers including stopped
docker ps -a

# Start a container
docker start <name>

# Stop a container
docker stop <name>

# Exec shell into running container
docker exec -it <name> bash

# View container logs live
docker logs -f <name>

# Build image from Dockerfile
docker build -t <name>:<tag> .

# Pull image from registry
docker pull <image>:<tag>

# Prune stopped containers and dangling images
docker system prune -f

# Remove unused volumes
docker volume prune

# List all images
docker images

# Docker Compose — start services
docker compose up -d

# Docker Compose — stop services
docker compose down

# Docker Compose — logs
docker compose logs -f

# Docker Compose — rebuild and restart
docker compose up -d --build

% network, tunnels, scanning

# Expose local port via Cloudflare tunnel
share <port>

# Expose Vaultwarden port 8222
tunnel 8222

# Interactive LAN network scanner
netscanner

# Port scanner (nmap)
nmap -sV <host>

# Scan all ports
nmap -p- <host>

# Interactive traceroute with packet loss (trippy)
trip <host>

# DNS lookup (dog — modern dig)
dog <domain>

# DNS lookup specific record type
dog <domain> <type>

# Visual real-time ping graph
gping <host1> <host2>

# Real-time bandwidth per process
bandwhich

# Show open ports and connections
ss -tulpn

# Send GET request with colored output
xh get <url>

# Send POST with JSON body
xh post <url> key=value

# Download file
wget <url>

# Download file multi-connection (aria2c)
aria2c -x 16 <url>

# ARP scan LAN
arp-scan -l

% security, vpn, passwords

# Unlock Bitwarden vault (persists session)
bw-unlock

# Open self-hosted Vaultwarden Web Vault
vw

# Point BW CLI to local Vaultwarden
bw-local

# Generate secure 24-char password
genpass

# Generate 4-word passphrase
genphrase

# List Bitwarden items
bw list items

# Get password for item
bw get password <item_name>

# Search Bitwarden items
bw list items --search <query>

# rbw list (no master password prompt)
rbw list

# rbw get password
rbw get <item>

# ProtonVPN — connect fastest server
protonvpn-cli connect --fastest

# ProtonVPN — connect to country
protonvpn-cli connect --cc <CC>

# ProtonVPN — disconnect
protonvpn-cli disconnect

# ProtonVPN — status
protonvpn-cli status

# SSH to remote host
ssh <user>@<host>

# Copy SSH key to remote
ssh-copy-id <user>@<host>

% media, video, audio, download

# Open NCMPCPP music player
music

# Open CAVA audio visualizer
vis

# Play/pause media (playerctl)
playerctl play-pause

# Next track
playerctl next

# Previous track
playerctl previous

# Volume up (pamixer)
pamixer -i 5

# Volume down
pamixer -d 5

# Mute/unmute toggle
pamixer -t

# Download video best quality
ytdl-best <url>

# Download audio as MP3
ytdl-mp3 <url>

# Download video (yt-dlp)
ytdl <url>

# Download playlist
yt-dlp -o '%(playlist_index)s-%(title)s.%(ext)s' <playlist_url>

# Download Spotify track/album/playlist
spot <url>

# Download images from gallery sites
gdl <url>

# Play video in terminal (mpv)
mpv <file>

# Play video with subtitles
mpv --sub-file=<subtitle.srt> <video>

# Convert video format (ffmpeg)
ffmpeg -i <input> <output.mp4>

# Extract audio from video
ffmpeg -i <input.mp4> -q:a 0 -map a <output.mp3>

# Record screen (ffmpeg)
ffmpeg -f x11grab -r 30 -s 1920x1080 -i :0.0 <output.mp4>

# Compress video (HandBrake CLI)
HandBrakeCLI -i <input> -o <output.mp4> --preset "Fast 1080p30"

# Show media file info (mediainfo)
mediainfo <file>

# Display image in terminal (chafa)
chafa <image>

# Display image in terminal (timg)
timg <image>

# Open image viewer (imv)
imv <image>

# Convert image format (imagemagick)
convert <input.png> <output.jpg>

# Resize image
convert <input> -resize 1920x1080 <output>

# Image to ASCII art (jp2a)
jp2a <image>

