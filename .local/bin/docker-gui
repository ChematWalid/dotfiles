#!/usr/bin/env bash
# docker-gui — Launch or open Portainer GUI for Docker
# Storage is on /mnt/drive2/docker-data/portainer

PORT=9000
DATA_DIR="/mnt/drive2/docker-data/portainer"

mkdir -p "$DATA_DIR"

if ! docker ps --format '{{.Names}}' | grep -q "^portainer$"; then
    if docker ps -a --format '{{.Names}}' | grep -q "^portainer$"; then
        echo "Starting existing Portainer container..."
        docker start portainer >/dev/null
    else
        echo "Launching Portainer CE on http://localhost:$PORT..."
        docker run -d \
            -p $PORT:9000 \
            -p 9443:9443 \
            --name portainer \
            --restart=always \
            -v /var/run/docker.sock:/var/run/docker.sock \
            -v "$DATA_DIR":/data \
            portainer/portainer-ce:latest
    fi
fi

# Wait briefly for port to be ready
sleep 1.5

# Open in default browser
if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "http://localhost:$PORT" &
fi
