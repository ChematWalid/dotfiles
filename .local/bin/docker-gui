#!/usr/bin/env bash
# docker-gui — Launch or open Portainer GUI for Docker
# Storage is on /mnt/drive2/docker-data/portainer

set -euo pipefail

readonly PORT=9000
readonly DATA_DIR="/mnt/drive2/docker-data/portainer"

# One inspect replaces two container listings and their grep subprocesses.
container_state=$(docker inspect --format '{{.State.Status}}' portainer 2>/dev/null || true)
mkdir -p "$DATA_DIR"

case "$container_state" in
    running)
        ;;
    "")
        echo "Launching Portainer CE on http://localhost:$PORT..."
        docker run -d \
            -p "${PORT}:9000" \
            -p "9443:9443" \
            --name portainer \
            --restart=always \
            -v /var/run/docker.sock:/var/run/docker.sock \
            -v "$DATA_DIR:/data" \
            portainer/portainer-ce:latest
        ;;
    *)
        echo "Starting existing Portainer container..."
        docker start portainer >/dev/null
        ;;
esac

# Return as soon as Portainer's unauthenticated status endpoint is ready. This
# avoids a fixed delay when the container is already serving, while still
# handling cold starts where `docker run` returns before the web server binds.
if command -v curl >/dev/null 2>&1; then
    ready=false
    for _ in {1..50}; do
        if curl --fail --silent --connect-timeout 0.1 --max-time 0.1 \
            "http://127.0.0.1:${PORT}/api/system/status" >/dev/null 2>&1; then
            ready=true
            break
        fi
        sleep 0.1
    done

    if [[ "$ready" != true ]]; then
        printf 'Portainer did not report ready within 10 seconds; opening it anyway.\n' >&2
    fi
fi

# Open in default browser
if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "http://localhost:$PORT" &
fi
