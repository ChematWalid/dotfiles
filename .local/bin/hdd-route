#!/usr/bin/env bash
# hdd-route — Move large app data to HDD and symlink back
# Edit: $EDITOR ~/.local/bin/hdd-route
# Usage: hdd-route steam | hdd-route docker | hdd-route all

HDD="/mnt/drive2"
HOME_SHARE="$HDD/.local/share"
CACHE="$HDD/.cache/home"

move_and_link() {
    local src="$1"
    local dst="$2"
    local name
    name=$(basename "$src")

    if [ -L "$src" ]; then
        echo "  → $name already symlinked, skipping"
        return
    fi

    if [ ! -e "$src" ]; then
        echo "  → $name not found at $src, creating empty dir on HDD"
        mkdir -p "$dst"
        ln -sfn "$dst" "$src"
        return
    fi

    echo "  Moving $src → $dst..."
    mkdir -p "$(dirname "$dst")"
    rsync -a --info=progress2 "$src/" "$dst/"
    if [ $? -eq 0 ]; then
        rm -rf "$src"
        ln -sfn "$dst" "$src"
        echo "  ✓ $name → HDD (symlinked)"
    else
        echo "  ✗ failed to move $name"
    fi
}

case "${1:-help}" in

  steam)
    echo "=== Routing Steam to HDD ==="
    move_and_link "$HOME/.local/share/Steam"     "$HOME_SHARE/Steam"
    move_and_link "$HOME/.steam"                 "$HDD/.steam"
    ;;

  docker)
    echo "=== Routing Docker to HDD (needs sudo) ==="
    sudo systemctl stop docker 2>/dev/null
    sudo mkdir -p "$HDD/.docker"
    sudo rsync -a /var/lib/docker/ "$HDD/.docker/"
    sudo rm -rf /var/lib/docker
    sudo ln -sfn "$HDD/.docker" /var/lib/docker
    sudo systemctl start docker 2>/dev/null
    echo "  ✓ Docker data → HDD"
    ;;

  vscode)
    echo "=== Routing VSCode extensions to HDD ==="
    move_and_link "$HOME/.vscode"                "$HDD/.vscode"
    move_and_link "$HOME/.vscode-server"         "$HDD/.vscode-server"
    ;;

  flatpak)
    echo "=== Routing Flatpak to HDD (needs sudo) ==="
    sudo rsync -a /var/lib/flatpak/ "$HDD/.flatpak/"
    sudo rm -rf /var/lib/flatpak
    sudo ln -sfn "$HDD/.flatpak" /var/lib/flatpak
    echo "  ✓ Flatpak → HDD"
    ;;

  virtualbox)
    echo "=== Routing VirtualBox VMs to HDD ==="
    move_and_link "$HOME/VirtualBox VMs"         "$HDD/VirtualBox VMs"
    ;;

  brave)
    echo "=== Routing Brave browser cache to HDD ==="
    move_and_link "$HOME/.cache/BraveSoftware"   "$CACHE/BraveSoftware"
    ;;

  all)
    echo "=== Routing all supported apps to HDD ==="
    $0 steam
    $0 vscode
    $0 brave
    ;;

  status)
    echo "=== HDD routing status ==="
    echo "--- Symlinks in ~/.cache ---"
    ls -la ~/.cache/ | grep "^l"
    echo ""
    echo "--- Symlinks in ~/.local/share ---"
    ls -la ~/.local/share/ | grep "^l" 2>/dev/null || echo "(none)"
    echo ""
    echo "--- Symlinks in ~/ ---"
    ls -la ~/ | grep "^l" | grep "mnt"
    echo ""
    echo "--- HDD usage ---"
    df -h /mnt/drive2 /mnt/drive3
    echo ""
    echo "--- SSD root free ---"
    df -h /
    ;;

  help|*)
    echo "hdd-route — Route large app data to HDD"
    echo ""
    echo "Usage: hdd-route <app>"
    echo ""
    echo "Apps:"
    echo "  steam      — Move Steam library to HDD"
    echo "  docker     — Move Docker data to HDD"
    echo "  vscode     — Move VSCode extensions to HDD"
    echo "  flatpak    — Move Flatpak data to HDD"
    echo "  virtualbox — Move VirtualBox VMs to HDD"
    echo "  brave      — Move Brave cache to HDD"
    echo "  all        — Route all detected apps"
    echo "  status     — Show current routing and disk usage"
    ;;
esac
