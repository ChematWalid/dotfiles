#!/usr/bin/env python3
"""
foliate-import: Import folders or book files directly into Foliate's library.
Supports CBZ, CBR, EPUB, PDF, MOBI, AZW, AZW3, FB2.
Generates metadata and cover thumbnails matching Foliate's exact storage format.
"""

from __future__ import annotations

import os
import sys
import json
import hashlib
import zipfile
import urllib.parse
from typing import TYPE_CHECKING

if TYPE_CHECKING:
    from PIL import Image

FOLIATE_DATA_DIR = os.path.expanduser("~/.local/share/com.github.johnfactotum.Foliate")
FOLIATE_CACHE_DIR = os.path.expanduser("~/.cache/com.github.johnfactotum.Foliate")
FOLIATE_LIB_DIR = os.path.join(FOLIATE_DATA_DIR, "library")
URI_STORE_PATH = os.path.join(FOLIATE_LIB_DIR, "uri-store.json")

SUPPORTED_EXTS = {".cbz", ".cbr", ".epub", ".pdf", ".mobi", ".azw", ".azw3", ".fb2"}
IMAGE_EXTS = (".png", ".jpg", ".jpeg", ".webp", ".gif")


def read_archive_image(archive: zipfile.ZipFile, name: str) -> Image.Image:
    """Decode an archive member directly, avoiding a full compressed bytes copy."""
    from PIL import Image

    with archive.open(name) as image_stream:
        image = Image.open(image_stream)
        image.load()
        # Pixel data is now resident; release the closed ZipExtFile reference.
        image.fp = None
        return image


def compute_identifier(file_path: str) -> str:
    """Foliate computes MD5 of first 10,000,000 bytes."""
    md5 = hashlib.md5()
    remaining = 10000000
    with open(file_path, "rb") as f:
        while remaining:
            chunk = f.read(min(1024 * 1024, remaining))
            if not chunk:
                break
            md5.update(chunk)
            remaining -= len(chunk)
    return f"foliate:{md5.hexdigest()}"


def extract_cbz_cover(cbz_path: str) -> Image.Image | None:
    """Extracts first image alphabetically from CBZ archive."""
    try:
        with zipfile.ZipFile(cbz_path) as z:
            first_image = min((
                member.filename for member in z.infolist()
                if member.filename.lower().endswith(IMAGE_EXTS)
                and not member.filename.startswith("__MACOSX")
            ), default=None)
            if first_image:
                return read_archive_image(z, first_image)
    except Exception as e:
        print(f"  [!] Failed to extract cover from {cbz_path}: {e}")
    return None


def extract_epub_cover(epub_path: str) -> Image.Image | None:
    """Extracts cover from EPUB archive."""
    try:
        with zipfile.ZipFile(epub_path) as z:
            # First try cover-named files
            members = z.infolist()
            for member in members:
                name = member.filename
                lower = name.lower()
                if "cover" in lower and lower.endswith(IMAGE_EXTS):
                    return read_archive_image(z, name)
            # Otherwise first image
            first_image = min((
                member.filename for member in members
                if member.filename.lower().endswith(IMAGE_EXTS)
            ), default=None)
            if first_image:
                return read_archive_image(z, first_image)
    except Exception as e:
        print(f"  [!] Failed to extract cover from {epub_path}: {e}")
    return None


def save_cover_thumbnail(img: Image.Image, output_path: str, target_width: int = 256):
    """Saves a scaled cover thumbnail matching Foliate's 256px bilinear PNG."""
    try:
        from PIL import Image

        # Convert RGBA / P to RGB if needed, or keep RGB/RGBA
        if img.mode not in ("RGB", "RGBA"):
            img = img.convert("RGB")
        width, height = img.size
        ratio = target_width / width
        if ratio < 1.0:
            target_height = round(height * ratio)
            img = img.resize((target_width, target_height), Image.Resampling.BILINEAR)
        img.save(output_path, "PNG")
    except Exception as e:
        print(f"  [!] Failed to save cover thumbnail: {e}")


def normalize_store_path(abs_path: str) -> str:
    """
    Normalizes path to match user's Foliate library convention:
    /mnt/drive3/... -> ~/E/... (via symlink ~/E -> /mnt/drive3)
    /home/walid/... -> ~/...
    """
    home = os.path.expanduser("~")
    drive3_prefix = "/mnt/drive3"
    
    if os.path.exists(os.path.join(home, "E")) and abs_path.startswith(drive3_prefix):
        rel = abs_path[len(drive3_prefix):].lstrip("/")
        return f"~/E/{rel}"
    elif abs_path.startswith(home):
        return "~" + abs_path[len(home):]
    return abs_path


def close_foliate_if_running():
    """Ask Foliate to quit and wait for its D-Bus name to disappear."""
    import subprocess

    try:
        check = subprocess.run([
            "gdbus", "call", "--session",
            "--dest", "com.github.johnfactotum.Foliate",
            "--object-path", "/com/github/johnfactotum/Foliate",
            "--method", "org.freedesktop.DBus.Peer.Ping",
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        print("Error: Cannot check Foliate state because gdbus is unavailable.", file=sys.stderr)
        return False
    if check.returncode != 0:
        return True

    try:
        from gi.repository import Gio, GLib

        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    except Exception as error:
        print(f"Error: Cannot wait for Foliate to close: {error}", file=sys.stderr)
        return False

    print("Closing running Foliate instance to preserve library sync...")
    loop = GLib.MainLoop()
    timed_out = False

    def owner_changed(_connection, _sender, _path, _interface, _signal, params, _data):
        name, _old_owner, new_owner = params.unpack()
        if name == "com.github.johnfactotum.Foliate" and not new_owner:
            loop.quit()

    try:
        subscription = bus.signal_subscribe(
            "org.freedesktop.DBus",
            "org.freedesktop.DBus",
            "NameOwnerChanged",
            "/org/freedesktop/DBus",
            "com.github.johnfactotum.Foliate",
            Gio.DBusSignalFlags.NONE,
            owner_changed,
            None,
        )
    except GLib.Error as error:
        print(f"Error: Cannot subscribe to Foliate shutdown: {error}", file=sys.stderr)
        return False

    try:
        quit_request = subprocess.run([
            "gdbus", "call", "--session",
            "--dest", "com.github.johnfactotum.Foliate",
            "--object-path", "/com/github/johnfactotum/Foliate",
            "--method", "org.gtk.Actions.Activate", "quit", "[]", "{}"
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as error:
        bus.signal_unsubscribe(subscription)
        print(f"Error: Could not ask Foliate to quit: {error}", file=sys.stderr)
        return False

    if quit_request.returncode != 0:
        bus.signal_unsubscribe(subscription)
        print("Error: Could not ask Foliate to quit; import cancelled.", file=sys.stderr)
        return False

    def stop_waiting():
        nonlocal timed_out
        timed_out = True
        loop.quit()
        return GLib.SOURCE_REMOVE

    timeout_id = GLib.timeout_add_seconds(5, stop_waiting)
    loop.run()
    if not timed_out:
        GLib.source_remove(timeout_id)

    bus.signal_unsubscribe(subscription)
    if timed_out:
        print("Error: Foliate did not close within 5 seconds; import cancelled.", file=sys.stderr)
        return False
    return True


def import_book(file_path: str, uri_entries: list, uri_index: dict) -> bool:
    abs_path = os.path.abspath(file_path)
    filename = os.path.basename(abs_path)
    ext = os.path.splitext(filename)[1].lower()

    if ext not in SUPPORTED_EXTS:
        return False

    try:
        identifier = compute_identifier(abs_path)
    except Exception as e:
        print(f"Error reading {abs_path}: {e}")
        return False

    encoded_id = urllib.parse.quote(identifier, safe="")
    json_path = os.path.join(FOLIATE_DATA_DIR, f"{encoded_id}.json")
    cover_path = os.path.join(FOLIATE_CACHE_DIR, f"{encoded_id}.png")
    store_path = normalize_store_path(abs_path)

    # 1. Write metadata JSON
    metadata = {
        "metadata": {
            "title": filename,
            "identifier": identifier
        }
    }
    with open(json_path, "w", encoding="utf-8") as f:
        json.dump(metadata, f, separators=(",", ":"))

    # 2. Extract and save cover thumbnail
    if not os.path.exists(cover_path):
        cover_img = None
        if ext == ".cbz":
            cover_img = extract_cbz_cover(abs_path)
        elif ext == ".epub":
            cover_img = extract_epub_cover(abs_path)

        if cover_img:
            save_cover_thumbnail(cover_img, cover_path)

    # 3. Add to uri_entries if not present
    existing_idx = uri_index.get(identifier)
    if existing_idx is not None:
        uri_entries[existing_idx] = [identifier, store_path]
    else:
        uri_entries.append([identifier, store_path])
        uri_index[identifier] = len(uri_entries) - 1

    return True


def main():
    args = sys.argv[1:]
    notify_after_import = bool(args and args[0] == "--notify")
    if notify_after_import:
        args = args[1:]
    target_dirs = args
    if not target_dirs:
        # Default to Entertainement/Manga
        default_path = os.path.expanduser("~/E/Entertainement/Manga")
        if not os.path.exists(default_path):
            default_path = "/mnt/drive3/Entertainement/Manga"
        target_dirs = [default_path]

    os.makedirs(FOLIATE_DATA_DIR, exist_ok=True)
    os.makedirs(FOLIATE_CACHE_DIR, exist_ok=True)
    os.makedirs(FOLIATE_LIB_DIR, exist_ok=True)

    foliate_closed = False

    def close_before_first_import():
        nonlocal foliate_closed
        if not foliate_closed:
            if not close_foliate_if_running():
                raise SystemExit("Import aborted because Foliate could not be closed safely.")
            foliate_closed = True

    # Load existing uri-store.json
    uri_entries = []
    if os.path.exists(URI_STORE_PATH):
        try:
            with open(URI_STORE_PATH, "r", encoding="utf-8") as f:
                store_data = json.load(f)
                uri_entries = store_data.get("uris", [])
        except Exception as e:
            print(f"Warning: Could not read existing {URI_STORE_PATH}: {e}")

    # Preserve the first matching entry, as the former linear search did, while
    # making per-book updates O(1) instead of scanning the full library each time.
    uri_index = {}
    for index, entry in enumerate(uri_entries):
        if entry:
            uri_index.setdefault(entry[0], index)

    imported_count = 0
    total_found = 0

    for target in target_dirs:
        target_path = os.path.expanduser(target)
        if os.path.isfile(target_path):
            total_found += 1
            print(f"Importing: {os.path.basename(target_path)}")
            close_before_first_import()
            if import_book(target_path, uri_entries, uri_index):
                imported_count += 1
        elif os.path.isdir(target_path):
            for root, _, files in os.walk(target_path):
                for f in sorted(files):
                    file_path = os.path.join(root, f)
                    ext = os.path.splitext(f)[1].lower()
                    if ext in SUPPORTED_EXTS:
                        total_found += 1
                        print(f"Importing: {f}")
                        close_before_first_import()
                        if import_book(file_path, uri_entries, uri_index):
                            imported_count += 1
        else:
            print(f"Path not found: {target_path}", file=sys.stderr)

    if notify_after_import and total_found == 0:
        for target in target_dirs:
            print(f"No supported ebook/manga files found in '{os.path.expanduser(target)}'.")
        return

    # Save updated uri-store.json
    with open(URI_STORE_PATH, "w", encoding="utf-8") as f:
        json.dump({"uris": uri_entries}, f, separators=(",", ":"))

    print(f"\nSuccessfully imported {imported_count}/{total_found} books into Foliate!")
    print(f"Total books now in Foliate library: {len(uri_entries)}")
    if notify_after_import and total_found:
        import subprocess
        try:
            subprocess.run([
                "notify-send", "-u", "normal", "-t", "4000",
                "-i", "com.github.johnfactotum.Foliate",
                "Foliate Library Updated",
                f"Imported {total_found} book(s) from "
                f"{os.path.basename(os.path.normpath(os.path.expanduser(target_dirs[0])))}",
            ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        except OSError:
            pass


if __name__ == "__main__":
    main()
