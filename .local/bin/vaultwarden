#!/usr/bin/env bash
# vaultwarden — Open self-hosted Vaultwarden in browser

readonly PORT=8222

start_container_and_wait() {
    local since event event_pid event_fd started=0
    printf -v since '%(%s)T' -1

    # Subscribe before starting the container; --since closes the small race
    # between Docker starting the stream and emitting the health event.
    coproc HEALTH_EVENTS {
        docker events --since "$since" \
            --filter type=container \
            --filter container=vaultwarden \
            --filter 'event=health_status: healthy' \
            --format '{{.Action}}' 2>/dev/null
    }
    event_pid=$HEALTH_EVENTS_PID
    event_fd=${HEALTH_EVENTS[0]}

    if docker start vaultwarden >/dev/null 2>&1 || sudo docker start vaultwarden >/dev/null 2>&1; then
        started=1
    fi

    if (( started )) && {
        ! IFS= read -r -t 10 -u "$event_fd" event ||
            [[ "$event" != 'health_status: healthy' ]]
    }; then
        printf 'Vaultwarden did not report healthy within 10 seconds; opening it anyway.\n' >&2
    fi

    kill "$event_pid" 2>/dev/null || true
    wait "$event_pid" 2>/dev/null || true
    exec {event_fd}<&- 2>/dev/null || true
}

# Inspect once instead of starting a Docker listing and grep pipeline.
container_state=$(docker inspect --format '{{.State.Status}}' vaultwarden 2>/dev/null || true)
if [[ "$container_state" != "running" ]]; then
    echo "Starting Vaultwarden container..."
    start_container_and_wait
fi

if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "https://localhost:$PORT" &
else
    echo "Vaultwarden is live at: https://localhost:$PORT"
fi
