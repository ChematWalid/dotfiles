#!/usr/bin/env bash
# vaultwarden — Open self-hosted Vaultwarden in browser

readonly PORT=8222

# Inspect once instead of starting a Docker listing and grep pipeline.
container_state=$(docker inspect --format '{{.State.Status}}' vaultwarden 2>/dev/null || true)
if [[ "$container_state" != "running" ]]; then
    echo "Starting Vaultwarden container..."
    docker start vaultwarden >/dev/null 2>&1 || sudo docker start vaultwarden >/dev/null 2>&1
    sleep 1
fi

if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "https://localhost:$PORT" &
else
    echo "Vaultwarden is live at: https://localhost:$PORT"
fi
