#!/usr/bin/env bash
# ── ayugram ───────────────────────────────────────────────────────────────────
# AyuGram / Telegram Desktop launcher with current-workspace focus management.
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail

export LD_LIBRARY_PATH="${HOME}/.local/share/AyuGram/lib:${LD_LIBRARY_PATH:-}"

exec "${HOME}/.local/bin/smart-open.sh" "^(AyuGramDesktop|AyuGram|TelegramDesktop)$" "${HOME}/.local/share/AyuGram/AyuGram" "$@"
