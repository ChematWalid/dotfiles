#!/usr/bin/env bash
# ── qbittorrent ───────────────────────────────────────────────────────────────
# qBittorrent launcher with current-workspace focus management.
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail

exec "${HOME}/.local/bin/smart-open.sh" "^qbittorrent$" /usr/bin/qbittorrent "$@"
