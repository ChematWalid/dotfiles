#!/usr/bin/env python3
"""
sync-antigravity — Bidirectional Conversation Synchronizer
Synchronizes conversations, artifacts, and summary catalogs between:
  • Antigravity Desktop IDE  (~/.gemini/antigravity)
  • Antigravity CLI (agy)    (~/.gemini/antigravity-cli)

Safety Guarantees:
  - 100% Non-destructive: Never deletes or overwrites existing conversations.
  - Automatic Backups: Backs up catalogs (.pb and .db) before modifying.
  - Atomic writes: Preserves catalog integrity even if interrupted.
"""

import os
import sys
import time
import shutil
import sqlite3
import json
from datetime import datetime, timezone

GUI_DIR = os.path.expanduser("~/.gemini/antigravity")
CLI_DIR = os.path.expanduser("~/.gemini/antigravity-cli")

GUI_CONVS = os.path.join(GUI_DIR, "conversations")
CLI_CONVS = os.path.join(CLI_DIR, "conversations")

GUI_BRAIN = os.path.join(GUI_DIR, "brain")
CLI_BRAIN = os.path.join(CLI_DIR, "brain")

GUI_PROTO = os.path.join(GUI_DIR, "agyhub_summaries_proto.pb")
CLI_DB = os.path.join(CLI_DIR, "conversation_summaries.db")

# ----------------- Protobuf Wire Helper -----------------

def parse_varint(buf, pos):
    val = 0
    shift = 0
    while True:
        b = buf[pos]
        pos += 1
        val |= (b & 0x7f) << shift
        if not (b & 0x80):
            break
        shift += 7
    return val, pos

def encode_varint(val):
    res = bytearray()
    while val > 0x7f:
        res.append((val & 0x7f) | 0x80)
        val >>= 7
    res.append(val & 0x7f)
    return bytes(res)

def encode_field(field_num, wire_type, data):
    tag = (field_num << 3) | wire_type
    if wire_type == 0:
        return encode_varint(tag) + encode_varint(data)
    elif wire_type == 2:
        return encode_varint(tag) + encode_varint(len(data)) + data
    raise ValueError(f"Unsupported wire type: {wire_type}")

def read_gui_proto():
    """Reads existing conversation IDs and entries from agyhub_summaries_proto.pb."""
    if not os.path.exists(GUI_PROTO):
        return {}, b""
    with open(GUI_PROTO, "rb") as f:
        data = f.read()
    
    pos = 0
    convs = {}
    while pos < len(data):
        tag, pos = parse_varint(data, pos)
        wire_type = tag & 0x7
        if wire_type != 2:
            break
        length, pos = parse_varint(data, pos)
        chunk = data[pos : pos + length]
        pos += length
        
        cpos = 0
        cid = None
        title = ""
        step_count = 0
        while cpos < len(chunk):
            ctag, cpos = parse_varint(chunk, cpos)
            cfn = ctag >> 3
            cwt = ctag & 0x7
            if cwt == 2:
                clen, cpos = parse_varint(chunk, cpos)
                cdata = chunk[cpos : cpos + clen]
                cpos += clen
                if cfn == 1:
                    cid = cdata.decode("utf-8", errors="ignore")
                elif cfn == 2:
                    # summary_info
                    spos = 0
                    while spos < len(cdata):
                        stag, spos = parse_varint(cdata, spos)
                        sfn = stag >> 3
                        swt = stag & 0x7
                        if swt == 2:
                            slen, spos = parse_varint(cdata, spos)
                            sval = cdata[spos : spos + slen]
                            spos += slen
                            if sfn == 1:
                                title = sval.decode("utf-8", errors="ignore")
                        elif swt == 0:
                            sval, spos = parse_varint(cdata, spos)
                            if sfn == 2:
                                step_count = sval
                        elif swt == 1: spos += 8
                        elif swt == 5: spos += 4
            elif cwt == 0:
                _, cpos = parse_varint(chunk, cpos)
            elif cwt == 1: cpos += 8
            elif cwt == 5: cpos += 4
        if cid:
            convs[cid] = {"title": title, "step_count": step_count}
    return convs, data

def build_gui_proto_entry(cid, title, step_count=1, ts=None, ws_uri=""):
    if ts is None:
        ts = int(time.time())
    ts_bytes = encode_field(1, 0, ts) + encode_field(2, 0, 0)
    
    summary = bytearray()
    summary += encode_field(1, 2, title.encode("utf-8"))
    summary += encode_field(2, 0, max(1, step_count))
    summary += encode_field(3, 2, ts_bytes)
    summary += encode_field(7, 2, ts_bytes)
    if ws_uri:
        ws_bytes = encode_field(1, 2, ws_uri.encode("utf-8")) + encode_field(2, 2, ws_uri.encode("utf-8"))
        summary += encode_field(9, 2, ws_bytes)
    
    entry = encode_field(1, 2, cid.encode("utf-8")) + encode_field(2, 2, bytes(summary))
    return encode_field(1, 2, entry)

# ----------------- Main Sync Logic -----------------

def parse_iso_ts(ts_str):
    if not ts_str:
        return int(time.time())
    try:
        # e.g. "2026-09-06 20:17:57.280456043+00:00"
        clean = ts_str.split("+")[0].split(".")[0].strip()
        dt = datetime.strptime(clean, "%Y-%m-%d %H:%M:%S")
        return int(dt.replace(tzinfo=timezone.utc).timestamp())
    except Exception:
        return int(time.time())

def sync(quiet_if_no_changes=False):
    if not quiet_if_no_changes:
        print("🔄 Antigravity Bidirectional Conversation Synchronizer")
        print("=" * 55)

    os.makedirs(GUI_CONVS, exist_ok=True)
    os.makedirs(CLI_CONVS, exist_ok=True)
    os.makedirs(GUI_BRAIN, exist_ok=True)
    os.makedirs(CLI_BRAIN, exist_ok=True)

    # 1. Backups
    if os.path.exists(GUI_PROTO):
        shutil.copy2(GUI_PROTO, f"{GUI_PROTO}.bak")
    if os.path.exists(CLI_DB):
        shutil.copy2(CLI_DB, f"{CLI_DB}.bak")

    # 2. Filesystem Sync: Conversations (.db, .pb)
    gui_dbs = {f for f in os.listdir(GUI_CONVS) if f.endswith(".db") or f.endswith(".pb")}
    cli_dbs = {f for f in os.listdir(CLI_CONVS) if f.endswith(".db") or f.endswith(".pb")}

    linked_to_cli = 0
    linked_to_gui = 0

    # GUI -> CLI
    for f in gui_dbs:
        dst = os.path.join(CLI_CONVS, f)
        src = os.path.join(GUI_CONVS, f)
        if not os.path.exists(dst):
            os.symlink(src, dst)
            linked_to_cli += 1

    # CLI -> GUI
    for f in cli_dbs:
        dst = os.path.join(GUI_CONVS, f)
        src = os.path.join(CLI_CONVS, f)
        if not os.path.exists(dst):
            os.symlink(src, dst)
            linked_to_gui += 1

    # 3. Filesystem Sync: Brain / Artifacts
    gui_brains = {d for d in os.listdir(GUI_BRAIN) if os.path.isdir(os.path.join(GUI_BRAIN, d))}
    cli_brains = {d for d in os.listdir(CLI_BRAIN) if os.path.isdir(os.path.join(CLI_BRAIN, d))}

    brain_to_cli = 0
    brain_to_gui = 0

    for d in gui_brains:
        dst = os.path.join(CLI_BRAIN, d)
        src = os.path.join(GUI_BRAIN, d)
        if not os.path.exists(dst):
            os.symlink(src, dst)
            brain_to_cli += 1

    for d in cli_brains:
        dst = os.path.join(GUI_BRAIN, d)
        src = os.path.join(CLI_BRAIN, d)
        if not os.path.exists(dst):
            os.symlink(src, dst)
            brain_to_gui += 1


    # 4. Catalog Sync: CLI -> GUI (Inject CLI conversations into Protobuf)
    gui_convs, raw_proto_data = read_gui_proto()
    
    cli_conn = sqlite3.connect(CLI_DB)
    cli_cur = cli_conn.cursor()
    
    cli_rows = cli_cur.execute("""
        SELECT conversation_id, title, preview, step_count, last_modified_time, workspace_uris
        FROM conversation_summaries
    """).fetchall()

    new_proto_entries = bytearray()
    added_to_gui_proto = 0

    for cid, title, prev, steps, mod_time, ws_uris in cli_rows:
        if cid not in gui_convs:
            disp_title = title.strip() or prev.strip() or "CLI Conversation"
            if len(disp_title) > 60:
                disp_title = disp_title[:57] + "..."
            ts = parse_iso_ts(mod_time)
            
            ws_uri = ""
            if ws_uris:
                try:
                    parsed_ws = json.loads(ws_uris)
                    if isinstance(parsed_ws, list) and parsed_ws:
                        ws_uri = str(parsed_ws[0])
                    elif isinstance(parsed_ws, str):
                        ws_uri = parsed_ws
                except Exception:
                    ws_uri = ws_uris.strip("[]\"' ")
                
            entry_bytes = build_gui_proto_entry(cid, disp_title, steps or 1, ts, ws_uri)
            new_proto_entries.extend(entry_bytes)
            gui_convs[cid] = {"title": disp_title, "step_count": steps}
            added_to_gui_proto += 1

    if added_to_gui_proto > 0:
        tmp_proto = f"{GUI_PROTO}.tmp"
        with open(tmp_proto, "wb") as f:
            f.write(raw_proto_data + bytes(new_proto_entries))
        os.replace(tmp_proto, GUI_PROTO)

    # 5. Catalog Sync: GUI -> CLI (Ensure GUI conversations in SQLite)
    existing_cli_cids = {r[0] for r in cli_cur.execute("SELECT conversation_id FROM conversation_summaries").fetchall()}
    added_to_cli_db = 0

    now_iso = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S.%f+00:00")
    for cid, data in gui_convs.items():
        if cid not in existing_cli_cids:
            title = data.get("title", "")
            steps = data.get("step_count", 1)
            cli_cur.execute("""
                INSERT INTO conversation_summaries (
                    conversation_id, title, preview, step_count, last_modified_time,
                    workspace_uris, status, source, project_id, agent_name,
                    parent_conversation_id, nesting_depth, battle_id, winning_conversation_id,
                    not_fully_idle, killed, last_user_input_time, last_user_input_step_index,
                    app_data_dir
                ) VALUES (
                    ?, ?, ?, ?, ?, '', '', '', '', '', '', 0, '', '', 0, 0, ?, -1, 'antigravity'
                )
            """, (cid, title, title, steps, now_iso, now_iso))
            added_to_cli_db += 1

    if added_to_cli_db > 0:
        cli_conn.commit()
    cli_conn.close()

    has_changes = (linked_to_cli + linked_to_gui + brain_to_cli + brain_to_gui + added_to_gui_proto + added_to_cli_db) > 0
    if not quiet_if_no_changes or has_changes:
        print(f"📦 Filesystem Sync:")
        print(f"   • Database links:    +{linked_to_cli} to CLI, +{linked_to_gui} to GUI")
        print(f"   • Brain directories: +{brain_to_cli} to CLI, +{brain_to_gui} to GUI")
        print(f"📑 Catalog Index Sync:")
        print(f"   • Injected into Desktop GUI (Protobuf): +{added_to_gui_proto} conversations")
        print(f"   • Injected into CLI (SQLite database):   +{added_to_cli_db} conversations")
        print(f"✅ Sync complete! Both interfaces share all conversations.")

def main():
    import argparse
    parser = argparse.ArgumentParser(
        description="Bidirectional conversation synchronizer between Antigravity Desktop IDE and CLI."
    )
    parser.add_argument("--watch", "-w", action="store_true", help="Continuously monitor and sync in the background.")
    parser.add_argument("--interval", "-n", type=int, default=10, help="Polling interval in seconds (default: 10).")
    args = parser.parse_args()

    if args.watch:
        print(f"👀 Watching Antigravity directories every {args.interval}s... (Press Ctrl+C to stop)")
        sync(quiet_if_no_changes=False)
        try:
            while True:
                time.sleep(args.interval)
                sync(quiet_if_no_changes=True)
        except KeyboardInterrupt:
            print("\n👋 Watcher stopped.")
    else:
        sync(quiet_if_no_changes=False)

if __name__ == '__main__':
    main()

