#!/usr/bin/env bash
# share-port — Expose a local port publicly through a Cloudflare quick tunnel.
# Usage: share-port --public PORT
set -euo pipefail

if [[ "${1:-}" != "--public" || $# -ne 2 ]]; then
  echo "Usage: share-port --public PORT" >&2
  echo "This creates a public internet URL for the local service on PORT." >&2
  exit 2
fi

PORT="$2"
if [[ ! "$PORT" =~ ^[0-9]+$ ]] || (( PORT < 1 || PORT > 65535 )); then
  echo "Invalid TCP port: $PORT" >&2
  exit 2
fi

echo "WARNING: port $PORT will be reachable from the public internet."
echo "Do not expose an unauthenticated or sensitive service. Press Ctrl+C to stop."

exec cloudflared tunnel --url "http://127.0.0.1:$PORT"
