#!/usr/bin/env bash
# Taskwarrior on-modify hook for Timewarrior synchronization
# Rewritten from Python to pure Bash + jq for zero Python runtime dependency and instant execution.
set -euo pipefail
IFS=$'\n\t'

# Read old and new task JSON from stdin
IFS= read -r old_line || exit 0
IFS= read -r new_line || exit 0

# Taskwarrior protocol requires outputting the new task JSON
printf '%s\n' "$new_line"

# If timew is not installed or inputs are empty, exit cleanly
if ! command -v timew >/dev/null 2>&1 || [ -z "$old_line" ] || [ -z "$new_line" ]; then
    exit 0
fi

# Parse actions and tags with jq
parsed=$(
  jq -n -c --argjson old "$old_line" --argjson new "$new_line" '
    def tags(t):
      [
        t.description,
        (t.project // empty),
        (if t.tags then (if (t.tags | type) == "string" then (t.tags | split(",")) else t.tags end)[] else empty end)
      ] | map(select(length > 0));

    def annotation(t):
      t.annotations[0].description // "\u0027\u0027";

    ($old.start != null) as $old_started |
    ($new.start != null) as $new_started |
    ($new.end != null) as $new_ended |

    if $new_started and ($old_started | not) then
      { action: "start", tags: tags($new) }
    elif $old_started and (($new_started | not) or $new_ended) then
      { action: "stop", tags: tags($new) }
    elif $old_started and $new_started then
      (tags($old)) as $old_t |
      (tags($new)) as $new_t |
      (annotation($old)) as $old_a |
      (annotation($new)) as $new_a |
      {
        action: "modify",
        tags_changed: ($old_t != $new_t),
        old_tags: $old_t,
        new_tags: $new_t,
        ann_changed: ($old_a != $new_a),
        new_ann: $new_a
      }
    else
      { action: "none" }
    end
  ' 2>/dev/null || true
)

if [ -z "$parsed" ]; then
    exit 0
fi

action=$(jq -r '.action' <<< "$parsed")

case "$action" in
    start)
        readarray -d '' tags < <(jq -j -r '.tags[] | . + "\u0000"' <<< "$parsed")
        if [ ${#tags[@]} -gt 0 ]; then
            timew start "${tags[@]}" :yes >/dev/null 2>&1 || true
        else
            timew start :yes >/dev/null 2>&1 || true
        fi
        ;;
    stop)
        readarray -d '' tags < <(jq -j -r '.tags[] | . + "\u0000"' <<< "$parsed")
        if [ ${#tags[@]} -gt 0 ]; then
            timew stop "${tags[@]}" :yes >/dev/null 2>&1 || true
        else
            timew stop :yes >/dev/null 2>&1 || true
        fi
        ;;
    modify)
        tags_changed=$(jq -r '.tags_changed' <<< "$parsed")
        if [ "$tags_changed" = "true" ]; then
            readarray -d '' old_tags < <(jq -j -r '.old_tags[] | . + "\u0000"' <<< "$parsed")
            readarray -d '' new_tags < <(jq -j -r '.new_tags[] | . + "\u0000"' <<< "$parsed")
            if [ ${#old_tags[@]} -gt 0 ]; then
                timew untag @1 "${old_tags[@]}" :yes >/dev/null 2>&1 || true
            fi
            if [ ${#new_tags[@]} -gt 0 ]; then
                timew tag @1 "${new_tags[@]}" :yes >/dev/null 2>&1 || true
            fi
        fi

        ann_changed=$(jq -r '.ann_changed' <<< "$parsed")
        if [ "$ann_changed" = "true" ]; then
            new_ann=$(jq -r '.new_ann' <<< "$parsed")
            timew annotate @1 "$new_ann" >/dev/null 2>&1 || true
        fi
        ;;
    *)
        ;;
esac

exit 0
